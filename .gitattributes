# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit source code and text formats that must always use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.example text eol=lf
Dockerfile* text eol=lf
*Dockerfile text eol=lf
*.dockerignore text eol=lf
*.gitignore text eol=lf
*.prettierignore text eol=lf
LICENSE text eol=lf

# Windows batch and script files (if any) must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary file types to prevent any line ending transformation
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.mkv binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
