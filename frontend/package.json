{
  "name": "streamrecorder-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/*.test.mjs\" \"tests/*.test.tsx\"",
    "test:integration": "node tests/integration.mjs",
    "lint": "node ../scripts/lint-repository.mjs lint frontend",
    "lint:fix": "node ../scripts/lint-repository.mjs lint:fix frontend",
    "format:check": "node ../scripts/lint-repository.mjs format:check frontend",
    "format:write": "node ../scripts/lint-repository.mjs format:write frontend",
    "lint:check": "node ../scripts/lint-repository.mjs lint frontend",
    "format": "node ../scripts/lint-repository.mjs format:write frontend"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "^27.4.0",
    "prettier": "3.8.1",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
