{
  "name": "StreamRecorder",
  "version": "1.0.0",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "pnpm test:api && pnpm test:frontend && pnpm test:worker",
    "test:smoke": "node scripts/docker-integration-smoke.mjs && node scripts/docker-bridge-smoke.mjs",
    "test:smoke:json": "node scripts/docker-integration-smoke.mjs",
    "test:smoke:bridge": "node scripts/docker-bridge-smoke.mjs",
    "lint": "node scripts/lint-repository.mjs lint",
    "lint:check": "node scripts/lint-repository.mjs lint",
    "lint:fix": "node scripts/lint-repository.mjs lint:fix",
    "format:check": "node scripts/lint-repository.mjs format:check",
    "format": "node scripts/lint-repository.mjs format:write",
    "format:write": "node scripts/lint-repository.mjs format:write",
    "check": "pnpm lint && pnpm format:check",
    "test:api": "pnpm --dir api test --runInBand",
    "test:frontend": "pnpm --dir frontend test",
    "test:worker": "node scripts/test-worker.mjs",
    "typecheck": "pnpm --dir api exec tsc --noEmit && pnpm --dir frontend typecheck",
    "build": "pnpm --dir api build && pnpm --dir frontend build",
    "test:db": "node scripts/test-db-foundation.mjs",
    "test:rehearsal": "node scripts/test-wave05-rehearsal.mjs",
    "compose:config": "docker compose -f compose.yml config --quiet",
    "compose:config:relational": "docker compose -f compose.yml -f compose.relational.yml config --quiet",
    "compose:config:authenticated": "docker compose -f compose.yml -f compose.relational.yml -f compose.authenticated.yml config --quiet"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=25.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.9.0",
    "prettier": "3.8.1"
  }
}
