# Copy to .env locally; NEVER commit .env. These are not production secrets.
# Mode A — JSON + Local (compose.yml); no DB, login, or bridge token required.
API_HOST_PORT=3000
FRONTEND_HOST_PORT=3001
RUNTIME_DATA_DIR=./runtime-data
RECORDINGS_DIR=./recordings
WORKER_POLL_INTERVAL=60
# Browser: http://127.0.0.1:3001; host API: http://127.0.0.1:3000
# Internal frontend/Worker API: http://api:3000 (not a browser URL).

# Mode B — PostgreSQL + Local (also compose.relational.yml).
# Mandatory opt-in: generate private values before enabling this overlay.
# Leave blank until configured; Compose rejects missing/empty values.
POSTGRES_PASSWORD=
INTERNAL_API_TOKEN=
# Optional database overrides. Use URL-safe credentials (e.g. random hex), since
# DATABASE_URL embeds them; percent-encode reserved URI characters if needed.
POSTGRES_USER=streamrecorder
POSTGRES_DB=streamrecorder
POSTGRES_PORT=5432
# Internal DB host is postgres:5432, not 127.0.0.1.
# Overlay fixes RELATIONAL_STORAGE=true, IDENTITY_MODE=local, PERSISTENCE_MODE=bridge,
# PERSISTENCE_BRIDGE_URL=http://api:3000 and OUTBOX_DIR=/outbox (persistent named volume).
# Mode A fixes RELATIONAL_STORAGE=false, IDENTITY_MODE=local, PERSISTENCE_MODE=direct_json.
# These mode settings are deliberately NOT independent .env switches.

# Mode C — PostgreSQL + Authenticated (also compose.authenticated.yml).
# Mandatory: exact browser frontend origin, adjusted if FRONTEND_HOST_PORT changes.
# Synthetic example, not a secret; never use an internal service URL here.
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3001
# Overlay fixes IDENTITY_MODE=authenticated. Migrations and an enabled enrolled
# CLI-managed user must exist first. Worker receives no human session cookies.
